# The same Upstash database as the metrics counter can store gallery messages.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Local development uses data/messages and needs no gallery credentials.
# Set to cloud only when intentionally testing the shared gallery locally.
# GALLERY_STORAGE=cloud

# Optional namespace prefix; default gallery keys are pools:messages:v1:*.
# POOLS_GALLERY_KEY=pools
